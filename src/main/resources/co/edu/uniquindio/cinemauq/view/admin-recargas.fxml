<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.cinemauq.controller.AdminRecargasController">
    <VBox styleClass="page" spacing="16">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label styleClass="page-title" text="Recargas"/>
                <Label styleClass="page-subtitle" text="Aprueba o rechaza las solicitudes de recarga de los clientes."/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#actualizar" styleClass="ghost-button" text="Actualizar"/>
        </HBox>

        <HBox spacing="16">
            <VBox prefWidth="240" spacing="4" styleClass="panel">
                <Label styleClass="form-label" text="PENDIENTES"/>
                <Label fx:id="pendientes" styleClass="summary-total" text="0"/>
            </VBox>
            <VBox prefWidth="280" spacing="4" styleClass="panel">
                <Label styleClass="form-label" text="MONTO PENDIENTE"/>
                <Label fx:id="montoPendiente" styleClass="summary-total" text="0"/>
            </VBox>
            <VBox spacing="8" styleClass="panel" HBox.hgrow="ALWAYS">
                <Label styleClass="section-title" text="Filtrar solicitudes"/>
                <ComboBox fx:id="filtroEstado" prefWidth="220"/>
            </VBox>
        </HBox>

        <HBox spacing="10">
            <Button onAction="#aprobar" styleClass="primary-button" text="Aprobar recarga"/>
            <Button onAction="#rechazar" styleClass="danger-button" text="Rechazar"/>
        </HBox>

        <TableView fx:id="tablaSolicitudes" prefHeight="430" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colSolicitudId" prefWidth="170" text="Solicitud"/>
                <TableColumn fx:id="colSolicitudCliente" prefWidth="240" text="Cliente"/>
                <TableColumn fx:id="colSolicitudFecha" prefWidth="210" text="Fecha"/>
                <TableColumn fx:id="colSolicitudMonto" prefWidth="150" text="Monto"/>
                <TableColumn fx:id="colSolicitudEstado" prefWidth="140" text="Estado"/>
            </columns>
            <placeholder>
                <Label styleClass="empty-text" text="No hay solicitudes de recarga."/>
            </placeholder>
        </TableView>
    </VBox>
</ScrollPane>
