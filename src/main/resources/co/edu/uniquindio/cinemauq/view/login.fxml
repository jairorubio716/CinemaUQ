<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="login-root" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="co.edu.uniquindio.cinemauq.controller.LoginController">
    <HBox maxHeight="650" maxWidth="1080" styleClass="login-card">
        <VBox prefWidth="560" styleClass="login-hero" spacing="18">
            <Label styleClass="hero-kicker" text="CINEMA UQ"/>
            <HBox spacing="0">
                <Label styleClass="login-brand" text="Cinema"/>
                <Label styleClass="login-brand login-brand-accent" text="UQ"/>
            </HBox>
            <Label styleClass="login-title" text="Tu próxima historia empieza aquí." wrapText="true"/>
            <Label styleClass="login-subtitle"
                   text="Compra entradas, elige tus asientos, agrega confitería y paga con tu tarjeta virtual. Todo en un solo lugar."
                   wrapText="true"/>
            <Region prefHeight="18"/>
            <Label styleClass="login-feature" text="🎟  Cartelera y funciones actualizadas"/>
            <Label styleClass="login-feature" text="💺  Selección de asientos en tiempo real"/>
            <Label styleClass="login-feature" text="🍿  Confitería y combos antes de pagar"/>
            <Label styleClass="login-feature" text="⭐  Puntos CinemaUQ en cada compra"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label styleClass="hint" text="Una experiencia de cine, hecha para la UQ."/>
        </VBox>

        <VBox prefWidth="440" styleClass="login-panel" spacing="16">
            <Label styleClass="login-heading" text="Bienvenido de vuelta"/>
            <Label styleClass="page-subtitle" text="Ingresa o crea tu cuenta para continuar."/>
            <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                <Tab text="Ingresar">
                    <VBox spacing="12">
                        <Label styleClass="form-label" text="USUARIO"/>
                        <TextField fx:id="usuarioLogin" promptText="demo"/>
                        <Label styleClass="form-label" text="CONTRASEÑA"/>
                        <PasswordField fx:id="contrasenaLogin" onAction="#ingresar" promptText="••••••••"/>
                        <Label fx:id="errorLogin" styleClass="form-error" wrapText="true"/>
                        <Button maxWidth="Infinity" onAction="#ingresar" styleClass="primary-button"
                                text="Entrar a CinemaUQ"/>
                        <Label styleClass="hint" wrapText="true"
                               text="Demo cliente: demo / demo123     Admin: admin / admin123"/>
                    </VBox>
                </Tab>
                <Tab text="Registrarme">
                    <VBox spacing="9">
                        <Label styleClass="form-label" text="NOMBRE COMPLETO"/>
                        <TextField fx:id="nombreRegistro" promptText="Tu nombre"/>
                        <Label styleClass="form-label" text="EMAIL"/>
                        <TextField fx:id="emailRegistro" promptText="tu@correo.com"/>
                        <Label styleClass="form-label" text="CELULAR"/>
                        <TextField fx:id="celularRegistro" promptText="300 000 0000"/>
                        <Label styleClass="form-label" text="USUARIO"/>
                        <TextField fx:id="usuarioRegistro" promptText="usuario"/>
                        <Label styleClass="form-label" text="CONTRASEÑA"/>
                        <PasswordField fx:id="contrasenaRegistro" onAction="#registrar" promptText="••••••••"/>
                        <Label fx:id="errorRegistro" styleClass="form-error" wrapText="true"/>
                        <Button maxWidth="Infinity" onAction="#registrar" styleClass="primary-button"
                                text="Crear mi cuenta"/>
                    </VBox>
                </Tab>
            </TabPane>
        </VBox>
    </HBox>
</StackPane>
