<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.cinemauq.controller.AdminReportesController">
    <VBox styleClass="page" spacing="16">
        <VBox spacing="3">
            <Label styleClass="page-title" text="Reportes"/>
            <Label styleClass="page-subtitle"
                   text="Genera, visualiza y exporta los reportes administrativos de CinemaUQ."/>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="panel">
            <Label styleClass="form-label" text="Reporte"/>
            <ComboBox fx:id="tipoReporte" prefWidth="310" promptText="Selecciona un reporte"/>
            <Label styleClass="form-label" text="Desde"/>
            <DatePicker fx:id="fechaInicio" prefWidth="150"/>
            <Label styleClass="form-label" text="Hasta"/>
            <DatePicker fx:id="fechaFin" prefWidth="150"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#generar" styleClass="primary-button" text="Generar reporte"/>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button onAction="#exportarTxt" styleClass="secondary-button" text="Exportar TXT"/>
            <Button onAction="#exportarPdf" styleClass="secondary-button" text="Exportar PDF"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="resumen" styleClass="hint" text="Selecciona un reporte y un periodo."/>
        </HBox>

        <HBox fx:id="metricas" spacing="14"/>

        <TabPane fx:id="tabs" styleClass="tab-pane" tabClosingPolicy="UNAVAILABLE">
            <Tab text="Detalle">
                <VBox spacing="8" styleClass="tab-content">
                    <Label styleClass="section-title" text="Registros del reporte"/>
                    <TableView fx:id="tablaReporte" prefHeight="390" styleClass="table-view">
                        <placeholder>
                            <Label styleClass="empty-text"
                                   text="No hay registros en el periodo seleccionado."/>
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>
            <Tab text="Barras">
                <VBox spacing="8" styleClass="tab-content">
                    <Label styleClass="section-title" text="Comparativo en barras"/>
                    <BarChart fx:id="graficoBarras" animated="false" legendVisible="false"
                              prefHeight="390" styleClass="chart">
                        <xAxis>
                            <CategoryAxis fx:id="ejeBarrasX"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="ejeBarrasY"/>
                        </yAxis>
                    </BarChart>
                </VBox>
            </Tab>
            <Tab text="Pastel">
                <VBox spacing="8" styleClass="tab-content">
                    <Label styleClass="section-title" text="Distribución del reporte"/>
                    <PieChart fx:id="graficoPastel" animated="false" prefHeight="390"
                              styleClass="chart"/>
                </VBox>
            </Tab>
            <Tab text="Líneas">
                <VBox spacing="8" styleClass="tab-content">
                    <Label styleClass="section-title" text="Evolución del reporte"/>
                    <LineChart fx:id="graficoLineas" animated="false" legendVisible="false"
                               prefHeight="390" styleClass="chart">
                        <xAxis>
                            <CategoryAxis fx:id="ejeLineasX"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="ejeLineasY"/>
                        </yAxis>
                    </LineChart>
                </VBox>
            </Tab>
        </TabPane>

        <Label styleClass="hint" wrapText="true"
               text="Cada reporte incluye título, fecha de generación, periodo consultado, registros encontrados y totales. Los archivos TXT y PDF se guardan en la ubicación que elijas."/>
    </VBox>
</ScrollPane>
