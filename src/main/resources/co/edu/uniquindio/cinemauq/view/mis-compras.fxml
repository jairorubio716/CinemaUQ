<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.cinemauq.controller.MisComprasController">
    <VBox styleClass="page" spacing="18">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label styleClass="page-title" text="Mis compras"/>
                <Label styleClass="page-subtitle" text="Consulta tus tickets, su estado y las opciones de cancelación."/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#actualizar" styleClass="ghost-button" text="Actualizar"/>
        </HBox>
        <VBox fx:id="lista" spacing="14"/>
        <VBox fx:id="vacio" alignment="CENTER" spacing="10" styleClass="empty-state">
            <Label styleClass="empty-icon" text="🎟"/>
            <Label styleClass="empty-text" text="Todavía no tienes compras. ¡La cartelera te espera!"/>
        </VBox>
    </VBox>
</ScrollPane>
